---
import type { Lesson } from "@lib/courses";
import { lessonHref } from "@lib/courses";

type Props = {
  track: string;
  lessons: Lesson[];
  currentOrder?: number;
};

const { track, lessons, currentOrder } = Astro.props;
---

<ol class="space-y-2" data-lesson-list data-track={track}>
  {lessons.map((lesson) => (
    <li>
      <a
        href={lessonHref(lesson)}
        data-order={lesson.data.order}
        aria-current={lesson.data.order === currentOrder ? "page" : undefined}
        class:list={[
          "group flex items-center gap-4 rounded-lg border px-4 py-3 transition-colors duration-300",
          lesson.data.order === currentOrder
            ? "border-blue-500/60 bg-blue-50/60 dark:bg-blue-950/30"
            : "border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5",
        ]}>
        <span class="relative flex size-7 shrink-0 items-center justify-center rounded-full border border-current text-xs font-semibold">
          <span data-lesson-number>{String(lesson.data.order).padStart(2, "0")}</span>
          <svg
            data-lesson-check
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="absolute hidden size-4 fill-none stroke-current stroke-[3]">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block truncate font-semibold text-black dark:text-white">
            {lesson.data.title}
          </span>
          <span class="block truncate text-sm text-gray-600 dark:text-gray-400">
            {lesson.data.description}
          </span>
        </span>
        <span class="shrink-0 text-xs text-gray-500 dark:text-gray-400">
          {lesson.data.minutes} min
        </span>
      </a>
    </li>
  ))}
</ol>

<script>
  import { trackProgress } from "@scripts/courses/progress";

  // A page renders one of these per phase, and this module runs once for all of
  // them, so every list has to be walked.
  function paint(): void {
    for (const list of document.querySelectorAll<HTMLElement>("[data-lesson-list]")) {
      const track = list.dataset.track;
      if (!track) continue;

      const { completed } = trackProgress(track);
      for (const order of completed) {
        const link = list.querySelector<HTMLElement>(`[data-order="${order}"]`);
        if (!link) continue;
        link.querySelector<HTMLElement>("[data-lesson-number]")?.setAttribute("hidden", "");
        link.querySelector<SVGElement>("[data-lesson-check]")?.classList.remove("hidden");
        link.classList.add("text-blue-700", "dark:text-blue-300");
      }
    }
  }

  // Under the ClientRouter this module is evaluated once for the whole session,
  // while a navigation back to the outline swaps in the build-time markup, with
  // no tick on any lesson. Reading storage on every page load rather than on
  // module eval is what keeps the list in step with progress written later on.
  document.addEventListener("astro:page-load", paint);
</script>
