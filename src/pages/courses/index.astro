---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import CourseSearch from "@components/courses/CourseSearch.astro";
import { getTracks, getLessons, trackStats } from "@lib/courses";
import { COURSES } from "@consts";

const tracks = await getTracks();
const cards = await Promise.all(
  tracks.map(async (track) => ({
    track,
    stats: trackStats(track.slug, await getLessons(track.slug)),
  }))
);
---

<PageLayout title={COURSES.TITLE} description={COURSES.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-3">
        <h1 class="text-2xl font-semibold text-black dark:text-white">Courses</h1>
        <p class="text-gray-600 dark:text-gray-400">{COURSES.DESCRIPTION}</p>
      </div>

      <div class="animate">
        <CourseSearch />
      </div>

      <div class="animate space-y-4">
        {cards.map(({ track, stats }) => (
          <a
            href={`/courses/${track.slug}`}
            class="group block rounded-lg border border-black/15 dark:border-white/20 p-5 transition-colors duration-300 hover:bg-black/5 dark:hover:bg-white/5">
            <div class="flex items-start gap-4">
              {track.data.logo && (
                <img
                  src={track.data.logo}
                  alt={track.data.logoAlt ?? ""}
                  width="32"
                  height="32"
                  class="mt-0.5 size-8 shrink-0"
                />
              )}
              <div class="min-w-0 flex-1">
                <div class="font-semibold text-black dark:text-white">{track.data.title}</div>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
                  {track.data.description}
                </p>
                <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
                  <span>{stats.lessonCount} lessons</span>
                  <span>~{stats.totalMinutes} min total</span>
                  <span>{stats.termCount} glossary terms</span>
                  <span class="capitalize">{track.data.level}</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </Container>
</PageLayout>
